# ---------------------------------------------------------------------------
# FinDocs AI — environment configuration
# Copy to `.env.local` and fill in. NOTHING here is required to run the demo:
# with no OPENAI_API_KEY the app runs in "local mode" (keyless embeddings +
# extractive answers) so the public demo is always-on and free.
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# Leave OPENAI_API_KEY blank to run in keyless LOCAL mode (no external calls).
# Set it to enable real embeddings + streamed generations.
OPENAI_API_KEY=
# Provider: "openai" (needs key) or "local" (keyless). "auto" picks openai when
# a key is present, otherwise local.
LLM_PROVIDER=auto
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Vector store -----------------------------------------------------------
# "memory" (default; per-instance, great for demo) or "pgvector".
VECTOR_STORE=memory
# Only used when VECTOR_STORE=pgvector. A Neon/Supabase/Postgres URL with the
# `vector` extension available. Example:
# postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Retrieval tuning -------------------------------------------------------
CHUNK_TOKENS=800
CHUNK_OVERLAP=0.15
RETRIEVAL_K=8
HYBRID_RETRIEVAL=true
MMR_ENABLED=true

# --- Safety / cost caps -----------------------------------------------------
# Per-IP limits protect the public demo from running up a bill.
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_HOUR=5
# Hard daily spend cap (USD). When exceeded, the app falls back to local mode.
MAX_DAILY_USD=2.00
# Upload guardrails
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=300
